{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "ask",
    "external_directory": "ask",
    "read": {
      "*": "allow",
      "*.env": "ask",
      "*.env.*": "ask",
      "*.env.example": "allow"
    },
    "bash": {
          "*": "ask",
          "git *": "allow",
          "npm *": "allow",
          "yarn *": "allow",
          "php *": "allow",
          "pnpm *": "allow",
          "npx *": "allow",
          "composer *": "allow",
          "grep *": "allow"
    },
    "skill": "allow",
    "lsp": "allow",
    "todowrite": "allow",
    "todoread": "allow",
    "websearch": "allow",
    "webfetch": "allow",
    "question": "allow"
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest", "--browser=firefox"],
      "enabled": false 
    }
  },
    "plugin": [
      ["opencode-notify", {}]
  ],
  "agent": {
    "auto-mode": {
        "description": "Vibe coding for the win",
        "mode": "primary",
        "prompt" : "",
        "permission": {
            "*": "allow"
        }
    }      
  }
}
